---
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { getAllPosts } from '../../lib/sanityClient';
import type { BlogPost } from '../../data/postsData';
import { PortableText } from 'astro-portabletext';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

export interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

const hasPortableText = Array.isArray(post.body) && post.body.length > 0;

// Helper léger de conversion Markdown vers HTML sémantique
function markdownToHtml(md: string): string {
  if (!md) return '';

  return md
    .split('\n\n')
    .map((block) => {
      const trimmed = block.trim();
      if (!trimmed) return '';

      // H2
      if (trimmed.startsWith('## ')) {
        const text = trimmed.replace(/^## /, '');
        return `<h2>${parseInline(text)}</h2>`;
      }
      // H3
      if (trimmed.startsWith('### ')) {
        const text = trimmed.replace(/^### /, '');
        return `<h3>${parseInline(text)}</h3>`;
      }
      // Blockquote / Alert
      if (trimmed.startsWith('> ')) {
        const text = trimmed.replace(/^>\s*/gm, '');
        return `<blockquote>${parseInline(text)}</blockquote>`;
      }
      // Unordered list
      if (trimmed.startsWith('- ') || trimmed.startsWith('* ')) {
        const items = trimmed
          .split('\n')
          .map((line) => line.replace(/^[-*]\s*/, ''))
          .map((item) => `<li><span>${parseInline(item)}</span></li>`)
          .join('');
        return `<ul>${items}</ul>`;
      }
      // Ordered list
      if (/^\d+\.\s/.test(trimmed)) {
        const items = trimmed
          .split('\n')
          .map((line) => line.replace(/^\d+\.\s*/, ''))
          .map((item) => `<li><span>${parseInline(item)}</span></li>`)
          .join('');
        return `<ol>${items}</ol>`;
      }

      // Standard Paragraph
      return `<p>${parseInline(trimmed)}</p>`;
    })
    .join('');
}

function parseInline(text: string): string {
  return text
    // Strong / Bold
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
    // Links with proper styling and internal linking preservation
    .replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2">$1</a>')
    // Line breaks
    .replace(/\n/g, '<br />');
}

const htmlContent = !hasPortableText && post.content ? markdownToHtml(post.content) : '';
---

<BlogPostLayout post={post}>
  {hasPortableText && post.body ? (
    <div class="prose max-w-none prose-h2:font-serif prose-h2:font-semibold prose-h2:text-ink-900 prose-h3:font-serif prose-h3:font-semibold prose-h3:text-accent-600 prose-p:text-ink-700 prose-p:leading-[1.8] prose-blockquote:border-l-4 prose-blockquote:border-accent-500 prose-blockquote:bg-mist-100 prose-blockquote:p-4 prose-blockquote:italic prose-a:text-accent-600 prose-a:underline hover:prose-a:text-ink-900 prose-ul:list-disc prose-ol:list-decimal">
      <PortableText value={post.body} />
    </div>
  ) : (
    <div set:html={htmlContent} />
  )}
</BlogPostLayout>
