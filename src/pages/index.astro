---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/sections/Hero.astro';
import AboutMarabout from '../components/sections/AboutMarabout.astro';
import LoveRituals from '../components/sections/LoveRituals.astro';
import VoyanceProtection from '../components/sections/VoyanceProtection.astro';
import ProcessSteps from '../components/sections/ProcessSteps.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import FaqAccordion from '../components/sections/FaqAccordion.astro';
import BlogPreview from '../components/sections/BlogPreview.astro';
import WhatsAppHub from '../components/sections/WhatsAppHub.astro';
import { getHomePage, getTestimonials, getFaqItems, getSiteSettings } from '../lib/sanityClient';

const [homePage, testimonials, faqs, siteSettings] = await Promise.all([
  getHomePage(),
  getTestimonials(),
  getFaqItems(),
  getSiteSettings(),
]);
---

<MainLayout
  title={`Retour Affectif Rapide & Voyance à Paris | ${siteSettings.brandTitle || 'Marabout Fabo Babassa'}`}
  description={siteSettings.defaultMetaDescription}
  canonicalUrl="https://www.marabout-fabo-babassa.fr/"
>
  <!-- Section 1 : Hero -->
  <Hero
    badge={homePage.heroBadge}
    title={homePage.heroTitle}
    lead={homePage.heroLead}
    ctaWaText={homePage.heroCtaWaText}
  />

  <!-- Section 2 : Présentation & Autorité (Le Marabout) -->
  <AboutMarabout
    badge={homePage.aboutBadge}
    title={homePage.aboutTitle}
    text1={homePage.aboutText1}
    text2={homePage.aboutText2}
  />

  <!-- Section 3 : Pôle Amour & Couple (Retour Affectif) -->
  <LoveRituals
    title={homePage.ritualsTitle}
    subtitle={homePage.ritualsSubtitle}
  />

  <!-- Section 4 : Voyance, Désenvoûtement & Chance -->
  <VoyanceProtection
    title={homePage.voyanceTitle}
    subtitle={homePage.voyanceSubtitle}
  />

  <!-- Section 5 : Déroulement d'une Consultation (Paris & Distance) -->
  <ProcessSteps
    title={homePage.stepsTitle}
    subtitle={homePage.stepsSubtitle}
  />

  <!-- Section 6 : Témoignages Clients (Avis France) -->
  <Testimonials testimonials={testimonials} />

  <!-- Section 7 : Foire Aux Questions (FAQ Accordéon) -->
  <FaqAccordion faqs={faqs} />

  <!-- Section 8 : Aperçu du Blog SEO (6 articles Sanity) -->
  <BlogPreview />

  <!-- Section 9 : Hub de Contact 100% WhatsApp (Zéro Formulaire) -->
  <WhatsAppHub
    title={homePage.waHubTitle}
    subtitle={homePage.waHubSubtitle}
  />
</MainLayout>
