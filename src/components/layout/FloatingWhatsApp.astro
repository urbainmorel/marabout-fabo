---
import { SITE_CONFIG } from '../../config/site';
import Icon from '../ui/Icon.astro';
---

<!-- Bouton flottant WhatsApp officiel (Mobile & Desktop) -->
<aside class="fixed bottom-[max(1.25rem,env(safe-area-inset-bottom))] right-4 sm:bottom-6 sm:right-6 z-50 flex items-center group" aria-label="Contact direct WhatsApp">
  <!-- Info-bulle Desktop au survol -->
  <div
    class="hidden md:flex items-center gap-2.5 mr-3 bg-white text-ink-900 py-2 px-3.5 rounded-full shadow-[0_4px_20px_rgba(0,0,0,0.12)] border border-ink-900/5 text-[13px] font-medium whitespace-nowrap opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 pointer-events-none select-none"
    role="tooltip"
    aria-hidden="true"
  >
    <span class="w-2 h-2 rounded-full bg-[#25D366] animate-pulse"></span>
    <span class="font-semibold text-ink-900">Écrire sur WhatsApp</span>
    <span class="text-ink-600 text-[11px]">• En ligne 7j/7</span>
  </div>

  <!-- Bouton d'action flottant officiel WhatsApp -->
  <a
    href={SITE_CONFIG.whatsappUrls.retourAffectif}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contacter le Marabout Fabo Babassa sur WhatsApp (ouvre une nouvelle fenêtre)"
    title="Écrire au Marabout Fabo sur WhatsApp"
    class="relative w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white flex items-center justify-center shadow-[0_8px_25px_rgba(37,211,102,0.5)] hover:shadow-[0_12px_32px_rgba(37,211,102,0.7)] hover:scale-105 active:scale-95 transition-all duration-300 focus:outline-none focus:ring-4 focus:ring-[#25D366]/40"
  >
    <!-- Onde d'impulsion subtile -->
    <span class="absolute inset-0 rounded-full bg-[#25D366] opacity-30 animate-ping pointer-events-none"></span>

    <!-- Pastille statut en ligne -->
    <span class="absolute top-0.5 right-0.5 w-3.5 h-3.5 bg-emerald-300 border-2 border-white rounded-full flex items-center justify-center shadow-sm" aria-hidden="true">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
    </span>

    <!-- Icône officielle WhatsApp blanche -->
    <Icon name="wa" class="relative w-7 h-7 sm:w-8 sm:h-8 text-white drop-shadow-sm" />
  </a>
</aside>
