---
import { SITE_CONFIG } from '../../config/site';
import Icon from '../ui/Icon.astro';
import Logo from '../ui/Logo.astro';

const links = [
  { href: '/#accueil', label: 'Accueil', mobile: 'Accueil' },
  { href: '/#le-marabout', label: 'Le Marabout', mobile: 'Le Marabout' },
  { href: '/#retour-affectif', label: "Rituels d'Amour", mobile: "Rituels d'Amour" },
  { href: '/#voyance-desenvoutement', label: 'Voyance & Protection', mobile: 'Voyance & Protection' },
  { href: '/blog', label: 'Blog', mobile: 'Blog' },
];
---

<header id="siteHeader" class="sticky top-0 z-50 w-full bg-black/95 backdrop-blur-xl border-b border-white/10 transition-shadow duration-300">
  <div class="max-w-[1320px] mx-auto px-5 sm:px-8 h-[76px] flex items-center justify-between gap-6">
    <!-- Logo + nom -->
    <a href="/#accueil" class="flex items-center gap-3.5 group text-left shrink-0" aria-label="Accueil - Marabout Fabo Babassa">
      <span class="w-11 h-11 rounded-2xl bg-white/10 ring-1 ring-white/20 flex items-center justify-center p-2 text-white group-hover:bg-accent-500 transition-colors duration-300">
        <Logo class="w-7 h-7" />
      </span>
      <span class="leading-tight">
        <span class="block font-serif text-[21px] font-semibold tracking-tight text-white">{SITE_CONFIG.name}</span>
        <span class="block text-[10px] uppercase tracking-[0.2em] text-white/60 font-medium">Voyant Médium &amp; Retour Affectif – Paris</span>
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-6 xl:gap-8 text-[14px] font-medium text-white/80" aria-label="Navigation principale">
      {links.map((l) => (
        <a href={l.href} class="relative py-2 hover:text-white transition-colors after:absolute after:left-0 after:bottom-0 after:h-px after:w-0 after:bg-accent-400 hover:after:w-full after:transition-all">{l.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href={SITE_CONFIG.whatsappUrls.general} target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex btn-wa !px-5 !py-3 !text-[11.5px]">
        <Icon name="wa" />
        <span>{SITE_CONFIG.phoneDisplay}</span>
      </a>
      <button
        id="mobileMenuToggle"
        class="lg:hidden w-11 h-11 rounded-full flex items-center justify-center border border-white/20 text-white hover:border-white transition-colors"
        aria-label="Ouvrir le menu de navigation"
        aria-expanded="false"
        aria-controls="mobileDrawer"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" d="M4 8h16M4 16h16" /></svg>
      </button>
    </div>
  </div>

  <!-- Tiroir mobile -->
  <div id="mobileDrawerOverlay" class="fixed inset-0 bg-ink-950/60 backdrop-blur-sm z-40 hidden opacity-0 transition-opacity duration-300"></div>
  <div
    id="mobileDrawer"
    class="fixed top-0 right-0 h-[100dvh] w-[86vw] max-w-sm bg-ink-900 text-white p-8 flex flex-col rounded-l-[32px] z-50 translate-x-full transition-transform duration-500 ease-[cubic-bezier(.22,1,.36,1)]"
  >
    <div class="flex items-center justify-between pb-6 border-b border-accent-300/15">
      <span class="text-[11px] uppercase tracking-[0.22em] text-accent-300">Navigation</span>
      <button id="drawerCloseBtn" class="w-10 h-10 flex items-center justify-center text-mist-100/70 hover:text-mist-100" aria-label="Fermer le menu">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>

    <nav class="flex flex-col py-6 font-serif text-[26px] leading-tight">
      {links.map((l) => (
        <a href={l.href} class="mobile-nav-link py-2 hover:text-accent-300 transition-colors">{l.mobile}</a>
      ))}
    </nav>

    <div class="mt-auto pt-6 border-t border-accent-300/15 flex flex-col gap-3">
      <a href={SITE_CONFIG.whatsappUrls.general} target="_blank" rel="noopener noreferrer" class="btn-wa w-full">
        <Icon name="wa" /><span>Écrire sur WhatsApp</span>
      </a>
      <a href={SITE_CONFIG.phoneHref} class="btn w-full ring-1 ring-white/25 text-mist-100 hover:bg-mist-100 hover:text-ink-900">
        <Icon name="phone" /><span>{SITE_CONFIG.phoneDisplay}</span>
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobileMenuToggle');
  const drawer = document.getElementById('mobileDrawer');
  const overlay = document.getElementById('mobileDrawerOverlay');
  const closeBtn = document.getElementById('drawerCloseBtn');
  const header = document.getElementById('siteHeader');

  function openMenu() {
    drawer?.classList.remove('translate-x-full');
    overlay?.classList.remove('hidden');
    requestAnimationFrame(() => overlay?.classList.remove('opacity-0'));
    toggleBtn?.setAttribute('aria-expanded', 'true');
    document.body.classList.add('menu-open');
  }
  function closeMenu() {
    drawer?.classList.add('translate-x-full');
    overlay?.classList.add('opacity-0');
    setTimeout(() => overlay?.classList.add('hidden'), 300);
    toggleBtn?.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('menu-open');
  }

  toggleBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);
  document.querySelectorAll('.mobile-nav-link').forEach((l) => l.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && closeMenu());

  const onScroll = () => header?.classList.toggle('shadow-[0_8px_30px_-18px_rgba(19,17,15,.35)]', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
