---
import { SITE_CONFIG } from '../../config/site';

export interface Props {
  isArticle?: boolean;
  hasFaq?: boolean;
  articleData?: {
    title: string;
    description: string;
    url: string;
    image: string;
    publishedAt: string;
  };
}

const { isArticle = false, hasFaq = false, articleData } = Astro.props;

const graph: any[] = [
  {
    '@type': 'ProfessionalService',
    '@id': `${SITE_CONFIG.siteUrl}/#marabout`,
    name: 'Marabout Fabo Babassa - Retour Affectif & Voyance Médium Paris',
    description:
      'Grand marabout voyant médium africain sérieux à Paris. Spécialiste du retour affectif rapide, du retour de l\'être aimé, de la fidélité conjugale, du désenvoûtement et des travaux spirituels à distance.',
    url: `${SITE_CONFIG.siteUrl}/`,
    telephone: '+33676197585',
    priceRange: '€€',
    image: `${SITE_CONFIG.siteUrl}/images/marabout-fabo-babassa-retour-affectif-paris.webp`,
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Consultations en cabinet sur RDV et à distance',
      addressLocality: 'Paris',
      postalCode: '75000',
      addressRegion: 'Île-de-France',
      addressCountry: 'FR',
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: 48.8566,
      longitude: 2.3522,
    },
    areaServed: [
      { '@type': 'Country', name: 'France' },
      { '@type': 'Country', name: 'Belgique' },
      { '@type': 'Country', name: 'Suisse' },
      { '@type': 'Country', name: 'Canada' },
    ],
    openingHoursSpecification: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '08:00',
      closes: '23:00',
    },
    sameAs: ['https://wa.me/33676197585'],
  },
];

if (hasFaq) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${SITE_CONFIG.siteUrl}/#faq`,
    mainEntity: [
      {
        '@type': 'Question',
        name: 'En combien de temps agit un rituel de retour affectif ?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Chaque situation amoureuse est unique. Les premiers signes d\'apaisement, de reprise de dialogue et de déblocage se manifestent progressivement selon la réceptivité énergétique de chaque couple.',
        },
      },
      {
        '@type': 'Question',
        name: 'Les travaux de retour de l\'être aimé comportent-ils un danger ?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Non, aucun danger ni choc en retour. Le Marabout Fabo Babassa pratique uniquement des rituels bienveillants et protecteurs qui favorisent l\'harmonie et le libre arbitre.',
        },
      },
      {
        '@type': 'Question',
        name: 'Comment consulter le Marabout Fabo Babassa à Paris ou à distance ?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Vous pouvez consulter le Marabout Fabo Babassa directement à son cabinet à Paris sur rendez-vous, ou à distance par WhatsApp et téléphone au 06 76 19 75 85.',
        },
      },
      {
        '@type': 'Question',
        name: 'Mon ex saura-t-il que j\'ai fait appel à un marabout pour le faire revenir ?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Jamais. Toute démarche est strictement confidentielle et respecte le secret professionnel le plus rigoureux.',
        },
      },
    ],
  });
}

if (isArticle && articleData) {
  graph.push({
    '@type': 'Article',
    '@id': `${articleData.url}#article`,
    headline: articleData.title,
    description: articleData.description,
    url: articleData.url,
    image: (() => {
      const img = articleData.image || '/images/og-banner-marabout-fabo-babassa.webp';
      return img.startsWith('http') ? img : `${SITE_CONFIG.siteUrl}${img}`;
    })(),
    datePublished: articleData.publishedAt,
    dateModified: articleData.publishedAt,
    author: {
      '@type': 'Person',
      name: 'Marabout Fabo Babassa',
      jobTitle: 'Grand Marabout Voyant Médium Africain',
      url: `${SITE_CONFIG.siteUrl}/`,
    },
    publisher: {
      '@type': 'Organization',
      name: 'Marabout Fabo Babassa',
      url: `${SITE_CONFIG.siteUrl}/`,
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': articleData.url,
    },
  });

  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${articleData.url}#breadcrumb`,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Accueil',
        item: `${SITE_CONFIG.siteUrl}/`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Guides & Rituels',
        item: `${SITE_CONFIG.siteUrl}/blog`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: articleData.title,
        item: articleData.url,
      },
    ],
  });
}

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': graph,
});
---

<script type="application/ld+json" set:html={jsonLd} />
