---
import { getAllPosts } from '../../lib/sanityClient';
import PostCard from '../ui/PostCard.astro';

const allPosts = await getAllPosts();
const recentPosts = allPosts.slice(0, 3);
---

<section id="blog" class="py-24 lg:py-32 max-w-[1320px] mx-auto px-5 sm:px-8">
  <div class="mb-16 reveal max-w-[900px]">
    <p class="eyebrow mb-6">Blog</p>
    <h2 class="display text-[34px] sm:text-[44px] lg:text-[52px] text-ink-900">
      Guides et Conseils : Tout Savoir sur le Retour Affectif et la Voyance
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-14">
    {recentPosts.map((post) => <PostCard post={post} />)}
  </div>

  <div class="mt-16 text-center">
    <a href="/blog" class="btn-line">
      <span>Voir les {allPosts.length} guides</span><span aria-hidden="true">→</span>
    </a>
  </div>
</section>
