---
import { SITE_CONFIG } from '../../config/site';

export interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = 'Voyance Médiumnique, Désenvoûtement et Travaux Occultes',
  subtitle = 'Au-delà du retour affectif, le Marabout Fabo Babassa vous accompagne à Paris et à distance pour lever tous les blocages invisibles qui freinent votre bonheur :',
} = Astro.props;

const poles = [
  {
    title: 'Consultation de Voyance Pure et Médiumnité',
    text: 'Par flashs médiumniques et supports traditionnels, découvrez la vérité sur votre avenir amoureux, familial ou financier pour faire les bons choix.',
    image: '/images/voyance-africaine-traditionnelle-paris-1.webp',
    alt: 'Consultation de voyance pure et flashs médiumniques à Paris',
    ctaLink: SITE_CONFIG.whatsappUrls.voyance,
  },
  {
    title: 'Désenvoûtement Puissant et Protection Contre le Mauvais Œil',
    text: 'Purification spirituelle profonde pour briser définitivement les mauvais sorts, la malchance inexpliquée et les énergies négatives qui vous bloquent.',
    image: '/images/desenvoutement-purification-mauvais-oeil.webp',
    alt: 'Désenvoûtement puissant et protection contre le mauvais œil',
    ctaLink: SITE_CONFIG.whatsappUrls.desenvoutement,
  },
  {
    title: 'Rituels de Chance, Prospérité et Réussite Professionnelle',
    text: "Cérémonies d'ouverture des chemins pour attirer les ondes positives, débloquer vos finances, attirer la clientèle et favoriser le succès.",
    image: '/images/rituel-chance-prospérite-financiere-1.webp',
    alt: 'Rituels de chance et prospérité financière à Paris',
    ctaLink: SITE_CONFIG.whatsappUrls.desenvoutement,
  },
];
---

<section id="voyance-desenvoutement" class="py-24 lg:py-32 max-w-[1320px] mx-auto px-5 sm:px-8">
  <div class="text-center max-w-[780px] mx-auto mb-14 reveal">
    <p class="eyebrow mb-6">Voyance &amp; Haute Protection</p>
    <h2 class="display text-[34px] sm:text-[44px] lg:text-[52px] text-ink-900">
      {title}
    </h2>
    <p class="lead mt-6">
      {subtitle}
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
    {poles.map((item, i) => (
      <a
        href={item.ctaLink}
        target="_blank"
        rel="noopener noreferrer"
        class="group relative overflow-hidden rounded-[30px] aspect-[4/5] shadow-[0_20px_50px_-20px_rgba(18,17,23,.3)] hover:shadow-[0_28px_60px_-15px_rgba(18,17,23,.4)] ring-1 ring-ink-900/10 transition-all duration-500 hover:-translate-y-1.5 block reveal"
        style={`transition-delay:${i * 90}ms`}
      >
        <img
          src={item.image}
          alt={item.alt}
          title={item.title}
          width="600"
          height="750"
          class="w-full h-full object-cover transition-transform duration-[1.2s] ease-out group-hover:scale-105"
          loading="lazy"
          decoding="async"
        />

        <!-- Superposition sombre légèrement transparente au bas de l'image -->
        <div class="absolute inset-x-0 bottom-0 pt-28 pb-6 sm:pb-7 px-6 sm:px-7 bg-gradient-to-t from-black/90 via-black/60 to-transparent flex flex-col justify-end">
          <h3 class="font-serif text-[21px] sm:text-[23px] leading-[1.25] text-white mb-2 group-hover:text-accent-300 transition-colors">
            {item.title}
          </h3>
          <p class="text-[13.5px] sm:text-[14px] leading-relaxed text-white/85 line-clamp-2">
            {item.text}
          </p>
        </div>
      </a>
    ))}
  </div>
</section>
