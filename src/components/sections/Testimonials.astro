---
import type { SanityTestimonial } from '../../lib/sanityClient';

export interface Props {
  testimonials?: SanityTestimonial[];
}

const { testimonials } = Astro.props;

const UserIcon = 'M7.5 6a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM3.751 20.105a8.25 8.25 0 0 1 16.498 0 .75.75 0 0 1-.437.695A18.683 18.683 0 0 1 12 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 0 1-.437-.695Z';

const Star = 'M11.48 3.5a.56.56 0 0 1 1.04 0l2.13 5.11 5.52.44c.5.04.7.66.32.99l-4.2 3.6 1.28 5.38a.56.56 0 0 1-.84.61L12 16.73l-4.73 2.9a.56.56 0 0 1-.84-.61l1.28-5.38-4.2-3.6a.56.56 0 0 1 .32-.99l5.52-.44 2.13-5.11Z';

interface TestimonialPair {
  cardA: {
    quote: string;
    author: string;
    role: string;
    tag: string;
  };
  cardB?: {
    author: string;
    date: string;
    stars: number;
    title: string;
    text: string;
    tag: string;
  };
}

// 6 binômes par défaut = 12 témoignages
const DEFAULT_PAIRS: TestimonialPair[] = [
  {
    cardA: {
      quote: "Le Marabout Fabo a changé ma vie. En moins de 10 jours, mon mari qui avait quitté le domicile a coupé tout contact avec sa maîtresse pour revenir à la maison.",
      author: "Céline M.",
      role: "Paris 16e",
      tag: "Retour Affectif & Foyer",
    },
    cardB: {
      author: "Marc D.",
      date: "14 Janvier 2026 · Lyon",
      stars: 5,
      title: "Un retour inespéré !",
      text: "Mon ex m'avait bloqué partout depuis 4 mois. Après la voyance et le rituel, elle m'a envoyé un message d'elle-même. Nous sommes à nouveau ensemble.",
      tag: "Retour de consultation",
    },
  },
  {
    cardA: {
      quote: "J'étais sceptique au début mais sa franchise m'a rassuré. Dès la première consultation, il a vu la rivale qui manipulait mon conjoint. Le rituel a été radical.",
      author: "Fatou S.",
      role: "Marseille",
      tag: "Éloignement de Rivale",
    },
    cardB: {
      author: "Laurent T.",
      date: "28 Janvier 2026 · Bordeaux",
      stars: 5,
      title: "Procédure de divorce annulée",
      text: "Notre couple était détruit par les disputes incessantes. Grâce au travail d'harmonie du maître Fabo, ma femme a renoncé au divorce. Un grand merci.",
      tag: "Sauvetage de Couple",
    },
  },
  {
    cardA: {
      quote: "Une précision de voyance déconcertante. Il a décrit mon passé et ma situation amoureuse sans poser la moindre question. Ses conseils m'ont évité le pire.",
      author: "Nathalie V.",
      role: "Bruxelles (Belgique)",
      tag: "Voyance Médiumnique Pure",
    },
    cardB: {
      author: "Alexandre P.",
      date: "09 Février 2026 · Nantes",
      stars: 5,
      title: "Fidélité retrouvée",
      text: "Mon partenaire avait des comportements volages. Depuis le rituel du cadenas, il est totalement dévoué à notre relation et très attentionné.",
      tag: "Rituel de Fidélité",
    },
  },
  {
    cardA: {
      quote: "Deux ans de malchance inexpliquée balayés en 3 semaines. Le désenvoûtement et la purification m'ont libéré d'un poids immense. Je revis enfin.",
      author: "Stéphane G.",
      role: "Lille",
      tag: "Désenvoûtement & Protection",
    },
    cardB: {
      author: "Yasmina K.",
      date: "22 Février 2026 · Toulouse",
      stars: 5,
      title: "Rapprochement en 7 jours",
      text: "Alors qu'il refusait de me parler, mon fiancé est venu sonner à ma porte en larmes pour demander pardon. Ce maître possède un véritable don héréditaire.",
      tag: "Retour de l'Être Aimé",
    },
  },
  {
    cardA: {
      quote: "Consulté à distance depuis la Martinique. Malgré les milliers de kilomètres, le rituel a fonctionné avec une force incroyable. Mon foyer est enfin apaisé.",
      author: "Marie-Line B.",
      role: "Fort-de-France (DOM-TOM)",
      tag: "Travail Occulte à Distance",
    },
    cardB: {
      author: "David R.",
      date: "05 Mars 2026 · Genève (Suisse)",
      stars: 5,
      title: "Déblocage et succès financier",
      text: "Mon commerce était au bord de la faillite. Le rituel d'ouverture de chemins a relancé ma clientèle au-delà de mes espérances. Reconnaissance infinie.",
      tag: "Chance & Prospérité",
    },
  },
  {
    cardA: {
      quote: "Un marabout honnête et disponible qui répond personnellement sur WhatsApp. Pas de fausses promesses, un accompagnement rigoureux du début à la fin.",
      author: "Inès L.",
      role: "Strasbourg",
      tag: "Accompagnement & Suivi",
    },
    cardB: {
      author: "Patrick M.",
      date: "18 Mars 2026 · Nice",
      stars: 5,
      title: "Protection contre le mauvais œil",
      text: "Notre famille subissait la jalousie de voisins malveillants. Depuis la pose du bouclier spirituel, nous avons retrouvé le sommeil et la sérénité.",
      tag: "Protection du Foyer",
    },
  },
];

const pairs: TestimonialPair[] = (testimonials && testimonials.length > 0)
  ? testimonials.reduce<TestimonialPair[]>((acc, item, idx) => {
      if (idx % 2 === 0) {
        acc.push({
          cardA: {
            quote: item.text,
            author: item.author,
            role: item.location,
            tag: item.title || item.serviceType || 'Retour Affectif',
          },
        });
      } else {
        const last = acc[acc.length - 1];
        if (last) {
          last.cardB = {
            author: item.author,
            date: item.location ? `${item.date} · ${item.location}` : item.date,
            stars: item.rating || 5,
            title: item.title || item.serviceType || 'Témoignage Client',
            text: item.text,
            tag: item.serviceType || 'Retour de consultation',
          };
        }
      }
      return acc;
    }, [])
  : DEFAULT_PAIRS;
---

<section id="avis" class="py-24 lg:py-32 max-w-[1320px] mx-auto px-5 sm:px-8 relative overflow-hidden">
  <!-- Halos d'ambiance en arrière-plan de section -->
  <div class="pointer-events-none absolute top-16 left-1/4 -translate-x-1/2 w-[620px] h-[620px] bg-accent-500/5 rounded-full blur-[140px] -z-10" aria-hidden="true"></div>
  <div class="pointer-events-none absolute bottom-12 right-1/4 translate-x-1/2 w-[580px] h-[580px] bg-oxblood-600/5 rounded-full blur-[130px] -z-10" aria-hidden="true"></div>

  <div class="text-center max-w-[820px] mx-auto mb-16 lg:mb-24 reveal">
    <p class="eyebrow mb-6">Témoignages &amp; Retours d'Expérience</p>
    <h2 class="display text-[34px] sm:text-[44px] lg:text-[52px] text-ink-900">
      Avis et Témoignages : Ils Ont Retrouvé l'Amour avec le Marabout Fabo Babassa
    </h2>
    <div class="mt-8 inline-flex flex-col sm:flex-row items-center gap-3 rounded-full sm:bg-mist-200 sm:pl-4 sm:pr-5 sm:py-2 ring-1 ring-ink-900/5 transition-all duration-300 hover:ring-accent-500/20 hover:shadow-sm">
      <span class="flex gap-0.5 text-accent-500">
        {Array.from({ length: 5 }).map(() => (
          <svg class="w-4 h-4 fill-current transition-transform duration-300 hover:scale-125" viewBox="0 0 24 24" aria-hidden="true">
            <path d={Star} />
          </svg>
        ))}
      </span>
      <span class="text-[13px] font-medium text-ink-700">Note moyenne : 4.9/5 (Plus de 140 retours positifs)</span>
    </div>
  </div>

  <!-- Grille de 6 binômes = 12 témoignages (2 binômes par ligne sur desktop, 1 binôme par ligne sur mobile) -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-10 lg:gap-x-12 gap-y-16 lg:gap-y-20 items-start">
    {pairs.map((pair, idx) => (
      <div 
        class="relative reveal testimonial-pair group/pair" 
        style={`transition-delay:${(idx % 2) * 120}ms`}
      >
        <!-- Halo doux sous chaque binôme s'intensifiant au survol -->
        <div 
          class="testimonial-aura absolute -inset-4 sm:-inset-6 bg-gradient-to-br from-accent-500/10 via-oxblood-600/5 to-transparent rounded-[36px] blur-2xl opacity-35 group-hover/pair:opacity-90 group-hover/pair:scale-105 transition-all duration-700 pointer-events-none -z-10" 
          aria-hidden="true"
        ></div>

        <!-- Carte A : fond teinté rosé doux (arrière-plan supérieur gauche) -->
        <div class="card-a-wrapper card-a-anim relative z-[2] transition-all duration-500">
          <div class="float-idle-a">
            <div class="card-a group/carda w-[92%] sm:w-[86%] rounded-[26px] bg-[#F6E8EE] p-6 sm:p-7 shadow-sm ring-1 ring-accent-500/10 transition-all duration-400 ease-out hover:shadow-[0_22px_45px_-10px_rgba(180,45,87,0.22)] hover:ring-accent-500/30 hover:-translate-y-2 hover:-translate-x-1 hover:rotate-[-0.6deg]">
              <!-- Icône de citation géante animée -->
              <div class="text-oxblood-600 mb-4 transition-all duration-300 group-hover/carda:scale-110 group-hover/carda:-rotate-6 group-hover/carda:text-accent-600 inline-block" aria-hidden="true">
                <svg class="w-9 h-9 fill-current opacity-85" viewBox="0 0 24 24">
                  <path d="M9.6 6C6.5 7.2 4.5 10 4.5 13.4V18h6v-6H7.6c.1-2 1.3-3.6 3-4.4L9.6 6Zm9 0c-3.1 1.2-5.1 4-5.1 7.4V18h6v-6h-2.9c.1-2 1.3-3.6 3-4.4L18.6 6Z"/>
                </svg>
              </div>

              <p class="font-serif text-[15px] sm:text-[16px] leading-[1.65] text-ink-900 mb-6 transition-colors duration-300 group-hover/carda:text-ink-950">
                « {pair.cardA.quote} »
              </p>

              <div class="flex items-center gap-3.5 pt-2">
                <!-- Avatar SVG Monochrome Blanc / Noir -->
                <div class="w-12 h-12 rounded-full bg-ink-900 text-white flex items-center justify-center ring-2 ring-white shadow-sm shrink-0 transition-transform duration-300 group-hover/carda:scale-105" aria-hidden="true">
                  <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                    <path fill-rule="evenodd" d={UserIcon} clip-rule="evenodd" />
                  </svg>
                </div>
                <div>
                  <p class="font-bold text-[14.5px] text-ink-900 leading-tight">{pair.cardA.author}</p>
                  <p class="text-[12.5px] text-ink-600 leading-tight mt-0.5">{pair.cardA.role}</p>
                </div>
              </div>
            </div>
          </div>

          <p class="text-[11px] font-bold tracking-[0.14em] uppercase text-accent-600/80 pl-3 mt-2.5 flex items-center gap-1.5 transition-all duration-300 group-hover/carda:text-oxblood-600 group-hover/carda:translate-x-1">
            <span class="w-1.5 h-1.5 rounded-full bg-accent-500/80 inline-block transition-transform duration-300 group-hover/carda:scale-125"></span>
            <span>{pair.cardA.tag}</span>
          </p>
        </div>

        <!-- Carte B : fond blanc surélevé (superposé en bas à droite) -->
        {pair.cardB && (
          <div class="card-b-wrapper card-b-anim relative z-[10] -mt-14 sm:-mt-18 ml-auto w-[92%] sm:w-[88%] transition-all duration-500">
            <div class="float-idle-b">
              <div class="card-b group/cardb relative overflow-hidden rounded-[26px] bg-white p-6 sm:p-7 shadow-[0_20px_45px_-12px_rgba(18,17,23,0.16)] ring-1 ring-ink-900/[0.08] transition-all duration-400 ease-out hover:shadow-[0_30px_60px_-15px_rgba(18,17,23,0.22),0_15px_30px_-10px_rgba(180,45,87,0.15)] hover:ring-accent-500/25 hover:-translate-y-2.5 hover:scale-[1.015]">
                <!-- Reflet lumineux élégant (shimmer sweep) au survol -->
                <div class="pointer-events-none absolute inset-0 overflow-hidden rounded-[26px]" aria-hidden="true">
                  <div class="shimmer-highlight absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/60 to-transparent group-hover/cardb:animate-shimmer"></div>
                </div>

                <div class="relative z-10">
                  <div class="flex items-center gap-3.5 mb-4">
                  <!-- Avatar SVG Monochrome Blanc / Noir -->
                  <div class="w-12 h-12 rounded-full bg-ink-900 text-white flex items-center justify-center ring-2 ring-accent-200/80 shadow-sm shrink-0 transition-transform duration-300 group-hover/cardb:scale-105" aria-hidden="true">
                    <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                      <path fill-rule="evenodd" d={UserIcon} clip-rule="evenodd" />
                    </svg>
                  </div>
                    <div>
                      <p class="font-bold text-[14.5px] text-ink-900 leading-tight">{pair.cardB.author}</p>
                      <p class="text-[12.5px] text-ink-500 leading-tight mt-0.5">{pair.cardB.date}</p>
                    </div>
                  </div>

                  <!-- Étoiles de notation avec cascade séquentielle au survol -->
                  <div class="flex gap-1 text-amber-400 mb-2.5" aria-label="5 étoiles sur 5">
                    {Array.from({ length: pair.cardB.stars }).map((_, sIdx) => (
                      <svg 
                        class="w-4 h-4 fill-current transition-all duration-300 group-hover/cardb:scale-125 group-hover/cardb:text-amber-500" 
                        style={`transition-delay: ${sIdx * 45}ms;`}
                        viewBox="0 0 24 24" 
                        aria-hidden="true"
                      >
                        <path d={Star} />
                      </svg>
                    ))}
                  </div>

                  <h3 class="font-serif font-bold text-[17px] sm:text-[18px] text-ink-900 leading-[1.4] sm:leading-[1.38] mb-2.5 transition-colors duration-300 group-hover/cardb:text-oxblood-600">
                    {pair.cardB.title}
                  </h3>

                  <p class="text-[13.5px] sm:text-[14px] leading-relaxed text-ink-600">
                    {pair.cardB.text}
                  </p>
                </div>
              </div>
            </div>

            <p class="text-[11px] font-bold tracking-[0.14em] uppercase text-accent-600/80 text-right pr-3 mt-2.5 flex items-center justify-end gap-1.5 transition-all duration-300 group-hover/cardb:text-oxblood-600 group-hover/cardb:-translate-x-1">
              <span class={`w-1.5 h-1.5 rounded-full inline-block ${pair.cardB.tag.includes('WhatsApp') ? 'bg-whatsapp' : 'bg-accent-500'}`}></span>
              <span>{pair.cardB.tag}</span>
            </p>
          </div>
        )}
      </div>
    ))}
  </div>

  <div class="mt-14 text-center">
    <p class="text-[12.5px] text-ink-500 max-w-[680px] mx-auto italic leading-relaxed">
      * Les retours d'expérience présentés ci-dessus sont des témoignages personnels de consultants. Dans le cadre de l'accompagnement spirituel, chaque situation humaine est unique et les résultats dépendent de la réceptivité et des circonstances propres à chaque démarche.
    </p>
  </div>
</section>

<style>
  /* Keyframes pour la respiration subtile */
  @keyframes floatA {
    0% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-5px) rotate(-0.35deg); }
    100% { transform: translateY(0px) rotate(0deg); }
  }

  @keyframes floatB {
    0% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(4.5px) rotate(0.35deg); }
    100% { transform: translateY(0px) rotate(0deg); }
  }

  @keyframes shimmerSweep {
    0% { transform: translateX(-150%) skewX(-20deg); }
    100% { transform: translateX(250%) skewX(-20deg); }
  }

  .card-b:hover .shimmer-highlight {
    animation: shimmerSweep 1.1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* ========================================================
     ANIMATIONS D'APPARITION & DISPARITION AU SCROLL
     ======================================================== */

  /* 1. ÉTAT HORS ÉCRAN PAR LE BAS (Position initiale / disparition vers le bas) */
  :global(.js) .testimonial-pair .card-a-anim {
    opacity: 0;
    transform: translate3d(-24px, 28px, 0) rotate(-1.5deg);
    transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.45s ease-in;
    will-change: transform, opacity;
  }

  :global(.js) .testimonial-pair .card-b-anim {
    opacity: 0;
    transform: translate3d(24px, 34px, 0) scale(0.95) rotate(1.2deg);
    transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.45s ease-in;
    will-change: transform, opacity;
  }

  :global(.js) .testimonial-pair .testimonial-aura {
    opacity: 0;
    transform: scale(0.85);
    transition: opacity 0.5s ease-in, transform 0.5s ease-in;
  }

  /* 2. ÉTAT HORS ÉCRAN PAR LE HAUT (Disparition vers le haut lors du scroll vers le bas) */
  :global(.js) .testimonial-pair.is-above:not(.is-in) .card-a-anim {
    opacity: 0;
    transform: translate3d(-18px, -28px, 0) rotate(1deg);
    transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.45s ease-in;
  }

  :global(.js) .testimonial-pair.is-above:not(.is-in) .card-b-anim {
    opacity: 0;
    transform: translate3d(18px, -34px, 0) scale(0.95) rotate(-1deg);
    transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.45s ease-in;
  }

  :global(.js) .testimonial-pair.is-above:not(.is-in) .testimonial-aura {
    opacity: 0;
    transform: scale(0.85);
  }

  /* 3. ÉTAT VISIBLE DANS LE VIEWPORT (Apparition scénarisée fluide) */
  :global(.js) .testimonial-pair.is-in .card-a-anim {
    opacity: 1;
    transform: translate3d(0, 0, 0) rotate(0deg);
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.js) .testimonial-pair.is-in .card-b-anim {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1) rotate(0deg);
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.1s, opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.1s;
  }

  :global(.js) .testimonial-pair.is-in .testimonial-aura {
    opacity: 0.35;
    transform: scale(1);
    transition: opacity 0.85s ease-out, transform 0.85s ease-out;
  }

  /* Laisser les cartes réaliser leur propre entrée scénarisée */
  :global(.js) .testimonial-pair.reveal {
    transform: none !important;
  }

  /* Interaction tactile et profondeur croisée entre les deux cartes via :has */
  .testimonial-pair:has(.card-a-wrapper:hover) .card-a-wrapper {
    z-index: 25;
  }

  .testimonial-pair:has(.card-a-wrapper:hover) .card-b-wrapper {
    transform: translate3d(4px, 6px, 0) scale(0.985);
    opacity: 0.9;
  }

  .testimonial-pair:has(.card-b-wrapper:hover) .card-a-wrapper {
    transform: translate3d(-4px, -4px, 0) scale(0.985);
    opacity: 0.85;
  }

  .testimonial-pair:has(.card-b-wrapper:hover) .card-b-wrapper {
    z-index: 30;
  }

  /* Respiration flottante au repos pour un rendu vivant et organique */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .testimonial-pair.is-in:not(:hover) .float-idle-a {
      animation: floatA 6.5s ease-in-out infinite;
    }
    :global(.js) .testimonial-pair.is-in:not(:hover) .float-idle-b {
      animation: floatB 7.5s ease-in-out infinite 0.6s;
    }
  }

  /* Respect strict de la préférence utilisateur pour la réduction de mouvement */
  @media (prefers-reduced-motion: reduce) {
    .float-idle-a,
    .float-idle-b,
    .shimmer-highlight {
      animation: none !important;
    }
    :global(.js) .testimonial-pair .card-a-anim,
    :global(.js) .testimonial-pair .card-b-anim {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>
