---
import { SITE_CONFIG } from '../../config/site';
import Icon from '../ui/Icon.astro';

export interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = 'Comment Fonctionne Votre Retour Affectif avec le Marabout Fabo Babassa ?',
  subtitle = 'Un protocole spirituel clair, rigoureux et transparent en 4 étapes pour rétablir l’amour et l’harmonie dans votre vie.',
} = Astro.props;

const steps = [
  {
    num: '01',
    title: 'Prise de contact directe et confidentielle sur WhatsApp',
  },
  {
    num: '02',
    title: 'Étude de voyance et diagnostic occulte',
  },
  {
    num: '03',
    title: "Réalisation du rituel d'amour ou de désenvoûtement",
  },
  {
    num: '04',
    title: "Accompagnement personnalisé jusqu'au résultat",
  },
];
---

<section id="fonctionnement" class="px-3 sm:px-5">
  <div class="on-dark grain rounded-[40px] bg-ink-900 text-white py-20 lg:py-28">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <div class="max-w-[820px] mb-14 reveal">
        <p class="eyebrow mb-6">Comment ça marche ?</p>
        <h2 class="display text-[34px] sm:text-[44px] lg:text-[52px]">
          {title}
        </h2>
        {subtitle && <p class="lead mt-4 text-white/75">{subtitle}</p>}
      </div>

      <ol class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {steps.map((s, i) => (
          <li class="group relative rounded-[24px] bg-white/[0.04] ring-1 ring-white/10 p-7 hover:bg-white/[0.07] transition-colors duration-300 reveal flex flex-col justify-between min-h-[170px]" style={`transition-delay:${i * 90}ms`}>
            <div class="flex items-center justify-between mb-6">
              <span class="w-12 h-12 rounded-2xl bg-white text-ink-900 flex items-center justify-center font-serif text-[20px]">{s.num}</span>
              {i < steps.length - 1 && <span class="hidden lg:block h-px flex-1 ml-4 bg-gradient-to-r from-white/25 to-transparent"></span>}
            </div>
            <h3 class="font-serif text-[20px] sm:text-[21px] leading-[1.25]">{s.title}</h3>
          </li>
        ))}
      </ol>

      <div class="mt-12 flex items-center reveal">
        <a href={SITE_CONFIG.whatsappUrls.retourAffectif} target="_blank" rel="noopener noreferrer" class="btn-wa">
          <Icon name="wa" /><span>Démarrer l'étape 1</span>
        </a>
      </div>
    </div>
  </div>
</section>
