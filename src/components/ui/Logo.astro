---
export interface Props {
  class?: string;
  size?: number;
}

const { class: cls = 'w-7 h-7', size } = Astro.props;
const style = size ? `width: ${size}px; height: ${size}px;` : undefined;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  fill="none"
  class={cls}
  style={style}
  aria-hidden="true"
>
  <!-- Sacred Akan Heart Silhouette -->
  <path
    d="M 50 88
       C 36 76, 12 55, 12 34
       C 12 16, 28 10, 43 15
       C 48 17, 50 22, 50 26
       C 50 22, 52 17, 57 15
       C 72 10, 88 16, 88 34
       C 88 55, 64 76, 50 88 Z"
    stroke="currentColor"
    stroke-width="6"
    stroke-linejoin="round"
  />

  <!-- Adinkra Core: Sankofa Volutes & Diamond of Return -->
  <!-- Spiral gauche -->
  <path
    d="M 50 32
       C 42 32, 28 36, 28 46
       C 28 55, 40 57, 44 50
       C 47 45, 44 39, 38 40"
    stroke="currentColor"
    stroke-width="4"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <!-- Spiral droite (miroir) -->
  <path
    d="M 50 32
       C 58 32, 72 36, 72 46
       C 72 55, 60 57, 56 50
       C 53 45, 56 39, 62 40"
    stroke="currentColor"
    stroke-width="4"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <!-- Losange central (lumière ancestrale & fidélité) -->
  <polygon points="50,60 56,68 50,76 44,68" fill="currentColor" />
</svg>
