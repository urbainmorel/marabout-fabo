---
import MainLayout from './MainLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { SITE_CONFIG } from '../config/site';
import type { BlogPost } from '../data/postsData';

export interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

const fullUrl = `${SITE_CONFIG.siteUrl}/blog/${post.slug}`;
---

<MainLayout
  title={`${post.metaTitle} | ${SITE_CONFIG.name}`}
  description={post.metaDescription}
  canonicalUrl={fullUrl}
  image={post.image || '/images/og-banner-marabout-fabo-babassa.webp'}
  type="article"
  isArticle={true}
  articleData={{
    title: post.title,
    description: post.metaDescription,
    url: fullUrl,
    image: post.image || '/images/og-banner-marabout-fabo-babassa.webp',
    publishedAt: post.publishedAt,
  }}
>
  <article>
    <!-- En-tête -->
    <header class="on-dark grain mx-3 sm:mx-5 mt-3 rounded-[40px] bg-ink-900 text-white pt-12 pb-40 lg:pb-48">
      <div class="max-w-[1320px] mx-auto px-5 sm:px-8">
        <nav class="flex items-center gap-2 text-[12px] text-mist-300/55 mb-14" aria-label="Fil d'Ariane">
          <a href="/" class="hover:text-accent-300 transition-colors">Accueil</a>
          <span>/</span>
          <a href="/blog" class="hover:text-accent-300 transition-colors">Blog &amp; Guides</a>
          <span>/</span>
          <span class="text-accent-300 truncate max-w-xs sm:max-w-md">{post.title}</span>
        </nav>
        <div class="max-w-[900px] mx-auto text-center">
          <p class="eyebrow mb-6">{post.categoryLabel}</p>
          <h1 class="display text-[36px] sm:text-[50px] lg:text-[60px] text-white">{post.title}</h1>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-[13px] text-white/65">
            <span>Par <strong class="text-white font-semibold">Marabout Fabo Babassa</strong></span>
            <span class="w-1 h-1 rounded-full bg-accent-400"></span>
            <time datetime={post.publishedAt}>
              {new Date(post.publishedAt).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
            </time>
            <span class="w-1 h-1 rounded-full bg-accent-400"></span>
            <span>Temps de lecture : {post.readingTime}</span>
          </div>
        </div>
      </div>
    </header>

    <div class="max-w-[1320px] mx-auto px-5 sm:px-8">
      <div class="max-w-[1040px] mx-auto -mt-28 lg:-mt-36 mb-16 lg:mb-20 rounded-[32px] overflow-hidden ring-[6px] ring-white shadow-[0_40px_80px_-40px_rgba(0,0,0,.5)]">
        <img
          src={post.image || '/images/og-banner-marabout-fabo-babassa.webp'}
          alt={post.imageAlt || post.title}
          title={post.title}
          width="1000"
          height="600"
          class="w-full h-auto object-cover max-h-[560px]"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="max-w-[1160px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-14 lg:gap-16 pb-24">
        <div class="lg:col-span-8">
          <p class="font-serif text-[24px] sm:text-[27px] leading-[1.5] text-ink-900 pb-10 mb-10 border-b border-ink-900/10 first-letter:float-left first-letter:font-serif first-letter:text-[78px] first-letter:leading-[0.8] first-letter:mr-3 first-letter:mt-1 first-letter:text-oxblood-600">
            {post.excerpt}
          </p>

          <div class="article-body max-w-none">
            <slot />
          </div>

          <div class="on-dark grain mt-16 rounded-[28px] bg-ink-900 text-white p-8 sm:p-12 sm:flex items-center justify-between gap-8">
            <div class="mb-6 sm:mb-0">
              <span class="block text-[11px] font-semibold uppercase tracking-[0.2em] text-accent-300 mb-3">
                Assistance Immédiate &amp; Discrète
              </span>
              <h3 class="font-serif text-[28px] leading-tight text-white mb-2">
                Besoin d'une voyance ou d'un rituel rapide ?
              </h3>
              <p class="text-[14px] text-white/70">
                Le Marabout Fabo Babassa répond personnellement à vos interrogations sur WhatsApp.
              </p>
            </div>
            <a href={SITE_CONFIG.getWhatsAppLink(post.whatsappCtaText)} target="_blank" rel="noopener noreferrer" class="btn-wa flex-shrink-0">
              <Icon name="wa" /><span>Écrire sur WhatsApp</span>
            </a>
          </div>
        </div>

        <aside class="lg:col-span-4">
          <div class="lg:sticky lg:top-28 space-y-6">
            <div class="card p-8 text-center">
              <div class="w-24 h-24 mx-auto rounded-full overflow-hidden ring-1 ring-accent-500 ring-offset-4 ring-offset-white mb-5">
                <img src="/images/maitre-spirituel-fabo-babassa-3.webp" alt="Marabout Fabo Babassa voyant médium africain" width="100" height="100" class="w-full h-full object-cover" loading="lazy" decoding="async" />
              </div>
              <h3 class="font-serif text-[24px] text-ink-900">Marabout Fabo Babassa</h3>
              <p class="text-[11px] uppercase tracking-[0.18em] text-accent-600 mt-1 mb-5">Grand Voyant Médium Africain à Paris</p>
              <p class="text-[13.5px] leading-[1.8] text-ink-600 mb-6">
                Spécialiste du retour affectif rapide, de la protection du foyer et de la levée des blocages spirituels. Consultations en cabinet à Paris et travaux occultes à distance.
              </p>
              <a href={SITE_CONFIG.getWhatsAppLink(post.whatsappCtaText)} target="_blank" rel="noopener noreferrer" class="btn-wa w-full !text-[12px]">
                <Icon name="wa" /><span>Consultation privée</span>
              </a>
            </div>

            <div class="card p-7 text-center">
              <span class="block text-[11px] font-semibold uppercase tracking-[0.2em] text-oxblood-600 mb-2">Urgence Sentimentale</span>
              <p class="text-[13px] text-ink-600 mb-3">Ligne téléphonique directe disponible 7j/7 :</p>
              <a href={SITE_CONFIG.phoneHref} class="inline-flex items-center gap-2 font-serif text-[26px] text-ink-900 hover:text-oxblood-600 transition-colors">
                <Icon name="phone" class="w-5 h-5 text-accent-600" /><span>{SITE_CONFIG.phoneDisplay}</span>
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </article>
</MainLayout>

<style is:global>
  .article-body h1, .article-body h2, .article-body h3, .article-body h4, .article-body h5, .article-body h6 { font-family: 'Merienda', cursive, serif; }
  .article-body h2 { font-weight: 600; font-size: clamp(26px, 2.8vw, 34px); line-height: 1.25; color: #13110F; margin: 3rem 0 1.25rem; }
  .article-body h3 { font-weight: 600; font-size: 23px; line-height: 1.3; color: #8E1E42; margin: 2.25rem 0 .9rem; }
  .article-body p { font-size: 16.5px; line-height: 1.9; color: #4A433C; margin-bottom: 1.4rem; }
  .article-body strong { color: #13110F; font-weight: 600; }
  .article-body a { color: #8E1E42; font-weight: 600; text-decoration: underline; text-decoration-color: #B42D57; text-underline-offset: 4px; }
  .article-body a:hover { color: #13110F; }
  .article-body blockquote { margin: 2rem 0; padding: 1.5rem 1.75rem; background: #F5F5F7; border-left: 3px solid #B42D57; border-radius: 18px; font-family: 'Merienda', cursive, serif; font-style: italic; font-size: 21px; line-height: 1.55; color: #13110F; }
  .article-body ul, .article-body ol { margin: 1.25rem 0 1.75rem; color: #4A433C; font-size: 16px; line-height: 1.8; }
  .article-body li { display: flex; gap: .85rem; margin-bottom: .7rem; }
  .article-body ul li::before { content: ''; flex-shrink: 0; width: 6px; height: 6px; margin-top: .7em; transform: rotate(45deg); background: #B42D57; }
  .article-body ol { counter-reset: step; }
  .article-body ol li { counter-increment: step; }
  .article-body ol li::before { content: counter(step, decimal-leading-zero); flex-shrink: 0; font-family: 'Merienda', cursive, serif; font-style: italic; font-size: 19px; color: #B42D57; min-width: 1.6rem; }
</style>
